<network-security-config>
    <!--
      Navidrome servers are commonly self-hosted on a local network over
      plain HTTP (no reverse-proxy TLS). Since the server URL is entered by
      the user at runtime rather than known at build time, it can't be
      scoped to a specific domain here - cleartext is allowed globally,
      matching how other self-hosted-media-server clients (Navic, Jellyfin,
      Plex) handle the same LAN-HTTP scenario.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
